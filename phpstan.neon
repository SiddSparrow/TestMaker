includes:
    - ./vendor/larastan/larastan/extension.neon
    - ./phpstan-baseline.neon

parameters:
    paths:
        - app
        - routes
        - config

    # Level 0 is the loosest and level 9 is the strictest
    level: 5

    excludePaths:
        - bootstrap/*.php
        - database/migrations/*
        - storage/*
        - vendor/*
        - node_modules/*
